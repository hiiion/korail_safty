FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string
# instance/ 폴더 기준
DATABASE_URL=sqlite:///app.db
# instance/ 폴더 기준
UPLOAD_DIR=uploads
MAX_CONTENT_LENGTH_MB=15
SESSION_HOURS=8
TIMEZONE=Asia/Seoul
# 관리번호 접두사 (작업지시서 기준 RSI → RSI-YYYYMMDD-NNN)
REPORT_NO_PREFIX=RSI

# --- Vercel + Supabase 배포 시 (README "Vercel + Supabase 배포" 참고) ---
# Supabase > Connect > Transaction pooler 주소 (포트 6543)
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB 비밀번호>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role 키 — 서버 전용, 브라우저·깃에 노출 금지>
# SUPABASE_BUCKET=photos
# SESSION_COOKIE_SECURE=1
